# Python
__pycache__/
*.pyc
*.egg-info/
# Nested setuptools build artifacts (e.g. chunker/build/lib/...) -- NOT the
# top-level build/ uv project (registry/build split, see
# specs/001-multi-version-serving/) or its own build/build/ package dir,
# which must stay tracked despite being named "build" too.
**/build/
!/build/
!/build/build/
.venv/

# Runtime logs
*.log

# Generated index / graph data (regenerate locally, see README)
# -- settings.yml under .cocoindex_code/ is real config, keep it tracked
**/.cocoindex_code/*.db
**/.cocoindex_code/*.sqlite*
**/graphify-out/

# Multi-version serving runtime state (specs/001-multi-version-serving) --
# all rebuildable from the upstream repo, per constitution Principle III
/data/.upstream-mirror/
/data/warm/
/data/staging/

# Local tool state -- never publish
.claude/
.serena/
